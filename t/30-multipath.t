use strict;
use warnings;

use Test::More;

use PVE::SAN::Multipath;

my $raw = <<'EOF';
sdb|active|ready|running|50|ds1
sdc|active|ready|running|50|ds1
sdd|failed|faulty|offline|10|ds1
sdf|undef|undef|running|1|[orphan]
junk line
EOF

my $p = PVE::SAN::Multipath::parse_paths_raw($raw);
is(scalar(keys %$p), 4, 'four paths parsed, junk ignored');
is($p->{sdb}->{chk_state}, 'ready', 'checker state');
is($p->{sdd}->{dm_state}, 'failed', 'dm state');
is($p->{sdd}->{priority}, 10, 'priority');
is($p->{sdf}->{chk_state}, undef, 'undef normalized');
is($p->{sdf}->{map}, undef, 'orphan path has no map');
is_deeply(PVE::SAN::Multipath::parse_paths_raw(undef), {}, 'no multipathd output');

my $conf = PVE::SAN::Multipath::render_conf({
    '3600a0b' => { alias => 'ds1', policy => 'round-robin' },
    '3600a0a' => { alias => 'ds2' },
    '3600a0c' => { policy => 'array-default' },
    '3600dead' => { alias => 'old', detached => 1 },
});

my $expected = join("\n",
    "# Generated by pvesan from /etc/pve/pvesan/config.json - DO NOT EDIT.",
    "# Use 'pvesan device set' or the GUI (Node > Disks > SAN) instead.",
    "",
    "blacklist {",
    "\twwid \"^3600dead\$\"",
    "}",
    "",
    "multipaths {",
    "\tmultipath {",
    "\t\twwid 3600a0a",
    "\t\talias ds2",
    "\t}",
    "\tmultipath {",
    "\t\twwid 3600a0b",
    "\t\talias ds1",
    "\t\tpath_grouping_policy multibus",
    "\t\tpath_selector \"service-time 0\"",
    "\t\tfailback immediate",
    "\t}",
    "}",
) . "\n";
is($conf, $expected, 'rendered multipath snippet');

is(PVE::SAN::Multipath::render_conf({}),
    "# Generated by pvesan from /etc/pve/pvesan/config.json - DO NOT EDIT.\n"
    . "# Use 'pvesan device set' or the GUI (Node > Disks > SAN) instead.\n",
    'empty config renders header only');

for my $name (@{PVE::SAN::Multipath::policy_names()}) {
    my $s = $PVE::SAN::Multipath::POLICIES->{$name}->{settings};
    is(scalar(@$s) % 2, 0, "policy $name has key/value pairs");
}

done_testing();
